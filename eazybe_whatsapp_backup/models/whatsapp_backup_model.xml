        <field name="name">x_eazybe_whatsapp_chat_count</field>
        <field name="field_description">WhatsApp Chats by Eazybe Count</field>
        <field name="ttype">integer</field>
        <field name="readonly">True</field>
        <field name="store">False</field>
        <field name="depends">x_eazybe_whatsapp_conversation_ids</field>
        <field name="compute"><![CDATA[
for partner in self:
    partner['x_eazybe_whatsapp_chat_count'] = sum(
        [conversation.x_message_count or 0 for conversation in partner.x_eazybe_whatsapp_conversation_ids]
    )
        ]]></field>
    </record>
